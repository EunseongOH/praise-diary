{
  "name": "praise-diary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "check:contrast": "node scripts-contrast.mjs",
    "check:syntax": "node scripts-verify-syntax.mjs",
    "test:logic": "node tests/logic.mjs",
    "check": "npm run check:syntax && npm run check:contrast && npm run check:design && npm run check:popups && npm run test:logic && npm run test:archive && npm run test:glyph && npm run test:motion && npm run build",
    "test:glyph": "node tests/glyph-layout.mjs",
    "check:design": "node tests/design-contract.mjs",
    "test:e2e": "playwright test",
    "test:motion": "node tests/rediscover-motion.mjs",
    "test:archive": "node tests/archive.mjs",
    "check:popups": "node tests/no-native-popups.mjs",
    "audit:ait": "node scripts/audit-ait-launch.mjs",
    "audit:ait:strict": "node scripts/audit-ait-launch.mjs --strict"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "@playwright/test": "1.56.1"
  }
}
